	fixture("dragonbone_dagger")
	var armored:=foe();armored.base_armor=40
	var baseline_damage:=armored.receive_attack({"damage":100},null)
	strike(armored,1,1)
	expect(armored.effective_armor()==28,"Dagger reduces actual effective armor immediately")
	expect(armored.receive_attack({"damage":100},null)>baseline_damage,"Armor reduction benefits attacks from unrelated sources")
	strike(armored,1,1)
	expect(armored.dragonbone_wounds.stacks==1,"Same strike cannot add a second armor stack")
	var second_fighter:=SlasherPlayer.new();second_fighter.setup(player.run_state);world.add_child(second_fighter);second_fighter.set_physics_process(false)
	var second_dagger:=ARSENAL.new();second_dagger.configure(second_fighter,"dragonbone_dagger",{});second_fighter.add_child(second_dagger);second_dagger.set_physics_process(false)
	second_dagger.hit(armored,{"damage":1,"warrior_cast":1,"warrior_kit":"dragonbone_dagger"},true)
	expect(armored.dragonbone_wounds.stacks==2 and armored.effective_armor()==16,"Distinct attackers share one armor stack set even with matching local cast IDs")
	second_dagger.hit(armored,{"damage":1,"warrior_cast":1,"warrior_kit":"dragonbone_dagger"},true)
	expect(armored.dragonbone_wounds.stacks==2,"Second attacker's repeated collision remains independently deduplicated")
	for i in range(2,30):strike(armored,i,1)
	expect(armored.dragonbone_wounds.stacks==6,"Shared wound set respects stack cap")
	armored.base_armor=0
