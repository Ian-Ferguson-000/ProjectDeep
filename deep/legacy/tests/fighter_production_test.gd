extends SceneTree

const ARSENAL=preload("res://game/player/warrior/slasher_fighter_arsenal.gd")
var world:Node2D
var player:SlasherPlayer
var kit:Node
var failures:Array[String]=[]
var checks:=0

func _initialize()->void:_run.call_deferred()
func expect(value:bool,message:String)->void:
	checks+=1
	if not value:failures.append(message);printerr("FAIL: "+message)

func fixture(id:String)->void:
	world=Node2D.new();root.add_child(world)
	var state:=RunState.new()
	state.start_new_run(GearData.create("fighter_test","Fighter",3,false,0,"","","warrior"),"forest")
	player=SlasherPlayer.new();player.setup(state);world.add_child(player)
	player.position=Vector2(400,400);player.set_physics_process(false)
	player.aim_direction=Vector2.RIGHT;player.attack_power=10;player.sprite.hide()
	kit=ARSENAL.new();kit.configure(player,id,{});player.add_child(kit);kit.set_physics_process(false)

func foe(hp:int=10000)->SlasherEnemy:
	var enemy:=SlasherEnemy.new();enemy.configure(1,false,"bandit_cutthroat")
	enemy.target=player;world.add_child(enemy);enemy.set_physics_process(false)
	enemy.position=player.position+Vector2(100,0);enemy.health=hp;enemy.max_health=hp
	enemy.sprite.hide();enemy.collision_layer=2
	return enemy

func strike(enemy:SlasherEnemy,serial:int,damage:int=1)->int:
	return kit.hit(enemy,{"damage":damage,"damage_type":"physical","damage_source":"Production test","warrior_kit":kit.weapon_id,"warrior_cast":serial,"warrior_resource":false},true)

func clear()->void:
	world.queue_free();await process_frame;await process_frame

func _run()->void:
	fixture("eldritch_bowstaff")
	var enemy:=foe()
	strike(enemy,1)
	expect(kit.curses[enemy.get_instance_id()].stacks==1,"First staff contact adds one curse")
	var health:=enemy.health
	strike(enemy,1)
	expect(enemy.health==health and kit.curses[enemy.get_instance_id()].stacks==1,"Repeated overlap cannot damage or stack twice")
	for serial in range(2,20):strike(enemy,serial)
	expect(kit.curses[enemy.get_instance_id()].stacks==6,"Curse cap holds under sustained pressure")
	kit._physics_process(1.0);strike(enemy,20)
	expect(is_equal_approx(float(kit.curses[enemy.get_instance_id()].left),8.0),"Staff contact refreshes full duration")
	enemy.receive_attack({"damage":20000,"damage_type":"physical"},null)
	expect(kit.spawned_beasts==6 and kit.curses.is_empty(),"External killer resolves capped curses once")
	var conversions:Array=kit.effects.filter(func(effect:Dictionary)->bool:return effect.kind=="curse_conversion")
	expect(conversions.size()==1 and int(conversions[0].count)==6,"Conversion feedback matches spawned beast count")
	kit._on_cursed_death(enemy,0)
	expect(kit.spawned_beasts==6,"Repeated death notification cannot duplicate beasts")
	var doomed:=foe(1);strike(doomed,21,10)
	expect(kit.spawned_beasts==7,"Lethal first staff hit contributes its curse before conversion")
	for i in 8:
		var crowd:=foe()
		for n in 6:strike(crowd,100+i*10+n)
		crowd.receive_attack({"damage":20000,"damage_type":"physical"},null)
	expect(get_nodes_in_group("corrupted_mini_beast").size()==24,"Simultaneous deaths respect global beast cap")
	expect(kit.spawned_beasts==24,"Overflow does not create hidden or queued summons")
	expect(kit.effects.any(func(effect:Dictionary)->bool:return effect.kind=="curse_overflow"),"Capped conversions visibly dissipate excess energy")
	var expiring:=foe();strike(expiring,1000);kit._physics_process(8.1)
	expect(kit.curses.is_empty(),"Curse duration expires")
	expect(not expiring.defeated.is_connected(kit._on_cursed_death),"Curse expiry removes its death listener")
	expiring.receive_attack({"damage":20000,"damage_type":"physical"},null)
	expect(kit.spawned_beasts==24,"Expired curse death cannot summon")
	await clear()
	fixture("eldritch_bowstaff")
	var shutdown_victim:=foe();strike(shutdown_victim,1);kit._tick_curses(9);strike(shutdown_victim,2)
	expect(shutdown_victim.defeated.is_connected(kit._on_cursed_death),"Reapplying an expired curse reconnects death conversion")
	kit.on_unequipped()
	expect(shutdown_victim.defeated.is_connected(kit._on_cursed_death) and not kit.curses.is_empty(),"Weapon swapping preserves a still-live curse and its conversion listener")
	expect(get_nodes_in_group("corrupted_mini_beast").is_empty(),"Shutdown test has free summon capacity rather than relying on cap rejection")
	player.health=0;shutdown_victim.receive_attack({"damage":20000},null)
	expect(kit.spawned_beasts==0 and kit.curses.is_empty(),"Owner death before the next tick prevents new beast conversions")
	await clear()
	fixture("valkyrian_sling")
	var attack:Dictionary=kit.attack_for("basic","Sling")
	kit._launch_sling(attack,false);kit._launch_sling(attack,true)
	expect(kit.missiles.size()==1,"Only one sling projectile per owner")
	var missile:Dictionary=kit.missiles[0]
	var baseline:=int(missile.attack.damage)
	missile.returning=true;missile.position=player.position+Vector2(50,0)
	kit.perform("defensive",{"started":true,"projectiles_deflected":0})
	expect(missile.damage_stacks==1 and not missile.returning,"Return parry starts exactly one new cycle")
	expect(int(missile.attack.damage)==baseline,"Parry never mutates original launch damage")
	kit.perform("defensive",{"started":true,"projectiles_deflected":0})
	expect(missile.damage_stacks==1,"Repeated parry input cannot score during outbound flight")
	missile.returning=true;missile.damage_stacks=int(kit.rules.parry_cap)
	expect(not kit.can_active_parry(),"Configured parry cap disables further amplification")
	missile.position=player.position+Vector2(50,0)
	expect(kit._tick_sling(missile,0.8),"Large simulation step catches returning projectile without overshoot")
	missile.returning=false;missile.life=0.01
	expect(kit._tick_sling(missile,0.02),"Lifetime cap terminates endless journeys")
	await clear()
	fixture("grim_reaver")
	var reaver_interval:=player.effective_attack_interval("basic",0.3)
	var reaver_speed:float=player.kit_buffs.speed_multiplier()
	var kills:Array[SlasherEnemy]=[]
	for i in 10:kills.append(foe(1))
	for victim in kills:strike(victim,1,20)
	expect(kit.rampage_stacks==6,"Crowd kills from one swing contribute independently up to cap")
	expect(kit.effects.filter(func(effect:Dictionary)->bool:return effect.kind=="rampage_start").size()==1,"Crowd kills produce one rampage activation mantle")
	expect(is_equal_approx(kit.critical_chance(),0.88),"Rampage critical chance is capped")
	expect(is_equal_approx(player.effective_attack_interval("basic",0.3),reaver_interval) and is_equal_approx(player.kit_buffs.speed_multiplier(),reaver_speed),"Rampage does not add attack or movement speed")
	var unowned:=foe(1)
	unowned.receive_attack({"damage":20},null)
	kit.rampage_stacks=0;kit.on_external_hit(unowned,{"warrior_kit":"other"},false)
	expect(kit.rampage_stacks==0,"Unrelated kills cannot award scythe rampage")
	var results:Dictionary={}
	seed(42)
	for i in 64:
		var victim:=foe()
		results[strike(victim,2,100)]=true
	expect(results.has(100) and results.has(175),"Each victim in a shared swing gets an independent critical roll")
	kit.rampage_stacks=6;kit.rampage_left=0.1;kit._physics_process(0.2)
	expect(kit.rampage_stacks==0 and is_equal_approx(kit.critical_chance(),0.28),"Rampage expires back to base crit chance")
	var revival_victim:=foe(1);strike(revival_victim,3,20)
	expect(kit.rampage_stacks==1 and kit.rampage_left>0,"Death-cleanup test begins with earned rampage")
	player.health=0;kit._physics_process(0.01)
	expect(kit.rampage_stacks==0 and kit.rampage_left==0,"Owner death clears Reaver rampage rather than freezing it")
	player.health=player.max_health;kit._physics_process(0.01)
	expect(is_equal_approx(kit.critical_chance(),0.28) and kit.rampage_left==0,"Revival cannot inherit the previous life's critical bonus")
	await clear()
	fixture("eldritch_bowstaff")
	var wall:=StaticBody2D.new();wall.position=player.position+Vector2(50,0)
	var shape:=CollisionShape2D.new();var rectangle:=RectangleShape2D.new()
	rectangle.size=Vector2(12,400);shape.shape=rectangle;wall.add_child(shape);world.add_child(wall)
	var behind_wall:=foe()
	var beast:=CorruptedMiniBeast.new().setup(player,player.position,0)
	world.add_child(beast);beast.set_physics_process(false)
	await physics_frame
	for i in 60:beast._physics_process(1.0/60.0)
	expect(beast.position.x<wall.position.x,"Summoned beast cannot walk through solid terrain")
	expect(behind_wall.health==10000,"Summoned beast cannot bite through a wall")
	var corpse_point:=player.position+Vector2(34,0)
	var safe_spawn:Variant=kit._corrupted_spawn_point(corpse_point,wall.position)
	expect(safe_spawn is Vector2 and Vector2(safe_spawn).x<=wall.position.x-14,"Corpse-local spawn reserves full beast footprint beside wall")
	beast.lifetime=0.01;beast._physics_process(0.02)
	expect(beast.is_queued_for_deletion(),"Beast lifespan terminates its collider and combat behavior")
	await clear()
	fixture("archon_crossbow")
	var first:=foe();first.position=player.position+Vector2(90,0)
	var second:=foe();second.position=player.position+Vector2(170,0)
	var heavy:=foe();heavy.position=player.position+Vector2(250,0);heavy.boss=true
	var shielded:=foe();shielded.position=player.position+Vector2(400,0)
	var barrier:=StaticBody2D.new();barrier.position=player.position+Vector2(330,0)
	var barrier_shape:=CollisionShape2D.new();var box:=RectangleShape2D.new();box.size=Vector2(12,300)
	barrier_shape.shape=box;barrier.add_child(barrier_shape);world.add_child(barrier)
	await physics_frame
	kit.rules.carry_cap=1
	kit._launch_archon({"damage":100,"warrior_cast":1,"warrior_kit":"archon_crossbow"},false)
	var bolt:Dictionary=kit.missiles[0]
	expect(not kit._tick_archon(bolt,0.25),"Archon remains active before range or terrain termination")
	expect(first.health==9900 and second.health==9865,"Swept bolt hits crossed targets in order with additive pierce bonus")
	expect(bolt.dragged.size()==1,"Archon respects carry cap while continuing to pierce")
	expect(first.mage_stun_remaining()>0,"Carried victim cannot run independently of bolt")
	expect(not first.sprite.is_playing() and first.facing_name=="left","Carried victim freezes facing against bolt travel")
	var carried_sprite_transform:=first.sprite.transform
	first._process_mage_control(0.01)
	expect(not first.sprite.is_playing() and first.sprite.transform==carried_sprite_transform,"Stun updates preserve carry pose without transforming combat geometry")
	first.clear_archon_carried(int(bolt.carry_source)-1)
	expect(not first.sprite.is_playing() and first.has_meta("fighter_archon_carrier"),"Other sources cannot release carried pose")
	var first_health:=first.health
	var heavy_position:=heavy.position
	expect(kit._tick_archon(bolt,0.5),"Fast bolt terminates at solid wall")
	expect(bolt.speared==3 and first.health==first_health,"Earlier victims are not damaged again by later pierces")
	expect(heavy.position==heavy_position,"Heavy victim takes damage without being carried")
	expect(shielded.health==10000,"Archon cannot damage enemy behind wall")
	expect(first.position.x<barrier.position.x and first.mage_stun_remaining()==0 and bolt.dragged.is_empty(),"Terrain termination releases carried enemies safely and clears movement restriction")
	expect(first.sprite.is_playing() and first.sprite.transform==carried_sprite_transform,"Archon release resumes animation without changing sprite geometry")
	await clear()
	fixture("umbral_bow")
	var marked:=foe();marked.speed=100
	kit._launch_umbral({"damage":1,"warrior_cast":1,"warrior_kit":"umbral_bow"},false)
	kit._tick_umbral(kit.missiles[0],0.3)
	expect(kit.leashes.size()==1,"Fast Umbral arrow cannot tunnel past its target")
	expect(is_equal_approx(player.kit_buffs.speed_multiplier(),1.0+45.0/player.speed),"Speed steal derives from enemy normal speed")
	var gain:float=player.kit_buffs.speed_multiplier()
	kit._add_leash(marked)
	expect(kit.leashes.size()==1 and is_equal_approx(gain,player.kit_buffs.speed_multiplier()),"Repeated tether refresh does not duplicate speed")
	marked.receive_attack({"damage":20000},null)
	expect(kit.leashes.is_empty() and player.kit_buffs.speed_multiplier()==1,"Death removes speed contribution immediately")
	expect(kit.effects.any(func(effect:Dictionary)->bool:return effect.kind=="tether_break"),"Death shows tether break without retaining stolen speed")
	var stationary:=foe();stationary.speed=0;kit._add_leash(stationary)
	expect(player.kit_buffs.speed_multiplier()==1,"Immobile enemy provides zero speed")
	for i in 8:kit._add_leash(foe())
	expect(is_equal_approx(player.kit_buffs.speed_multiplier(),1.6),"Many tethers respect total haste cap")
	kit._update_leashes(4.1)
	expect(kit.leashes.is_empty() and player.kit_buffs.speed_multiplier()==1,"Expiry restores all stolen speed")
	var distant:=foe();kit._add_leash(distant);distant.position+=Vector2(800,0);kit._update_leashes(0)
	expect(kit.leashes.is_empty() and distant.mage_slow_multiplier==1,"Distance break removes both ends of tether")
	expect(not distant.defeated.is_connected(kit._leashed_death) and not distant.tree_exiting.is_connected(kit._remove_leash.bind(distant.get_instance_id())),"Tether removal disconnects its death and despawn listeners")
	distant.position=player.position+Vector2(100,0);kit._add_leash(distant)
	expect(distant.defeated.is_connected(kit._leashed_death) and distant.tree_exiting.is_connected(kit._remove_leash.bind(distant.get_instance_id())),"Retethering restores lifecycle listeners")
	kit._add_leash(distant)
	var tether_listeners:=0
	for connection in distant.defeated.get_connections():
		if connection.callable==kit._leashed_death:tether_listeners+=1
	expect(tether_listeners==1,"Tether refresh cannot duplicate death listeners")
	kit._remove_leash(distant.get_instance_id())
	var breaks_before:int=kit.effects.filter(func(effect:Dictionary)->bool:return effect.kind=="tether_break").size()
	kit._remove_leash(distant.get_instance_id())
	expect(kit.effects.filter(func(effect:Dictionary)->bool:return effect.kind=="tether_break").size()==breaks_before,"Repeated removal cannot duplicate break feedback")
	var disappearing:=foe();kit._add_leash(disappearing);disappearing.queue_free();await process_frame
	expect(kit.leashes.is_empty() and player.kit_buffs.speed_multiplier()==1,"Despawn immediately clears tether contribution")
	var swapped:=foe();kit._add_leash(swapped);kit.set_meta("active_item_runtime_id","umbral_bow");kit._physics_process(0.01)
	expect(kit.leashes.is_empty() and swapped.mage_slow_multiplier==1,"Unequipped active item clears tether and slow")
