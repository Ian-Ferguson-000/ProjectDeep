extends "res://tests/fighter_production_test.gd"

func _run()->void:
	fixture("divine_hammer")
	var fleeing:=foe();fleeing.position=player.position+Vector2(100,0)
	var replacement:=foe();replacement.position=player.position+Vector2(0,120)
	kit._queue_hammer({"damage":10,"warrior_cast":1},1,fleeing)
	player.sprite.set_frame_and_progress(3,0.4)
	var before_speed:=player.sprite.get_playing_speed()
	var before_time:float=kit.hammer_chain.left
	fleeing.position+=Vector2(600,0)
	kit._tick_hammer(0.01)
	expect(kit.hammer_chain.target.get_ref()==replacement,"Repeat replaces a target that leaves chain range during windup")
	expect(player.facing_name=="down" and String(player.sprite.animation).ends_with("_down"),"Hammer retarget turns both actor facing and active sprite")
	expect(player.sprite.frame==3 and absf(player.sprite.frame_progress-0.4)<0.001,"Hammer retarget preserves the current animation pose instead of restarting")
	expect(is_equal_approx(player.sprite.get_playing_speed(),before_speed) and absf(float(kit.hammer_chain.left)-(before_time-0.01))<0.001,"Hammer retarget preserves playback rate and authoritative contact deadline")
	kit._tick_hammer(0.2)
	expect(replacement.health<replacement.max_health and fleeing.health==fleeing.max_health,"Retargeted smash damages only a reachable target")
	await clear()
	fixture("divine_hammer")
	var escaping:=foe();kit._queue_hammer({"damage":10,"warrior_cast":1},1,escaping)
	escaping.position+=Vector2(600,0)
	var start:=player.position;player.cooldowns.basic=3
	kit._tick_hammer(0.2)
	expect(kit.hammer_chain.is_empty() and player.cooldowns.basic==0 and player.position==start,"No reachable replacement ends chain refreshed without chasing distant target")
	await clear()
	fixture("divine_hammer");player.warrior_kit=kit
	var hidden:=foe();hidden.position=player.position+Vector2(80,0)
	var wall:=StaticBody2D.new();wall.position=player.position+Vector2(40,0)
	var shape:=CollisionShape2D.new();var box:=RectangleShape2D.new();box.size=Vector2(12,400)
	shape.shape=box;wall.add_child(shape);world.add_child(wall)
	await physics_frame
	kit.perform("basic",{"started":true})
	expect(Vector2(kit.hammer_chain.point).x<wall.position.x-6,"First anticipation frame does not advertise an impact beyond terrain")
	kit._tick_hammer(0.1)
	expect(Vector2(kit.hammer_chain.point).x<wall.position.x-6,"Empty-smash preview stays on reachable side of close wall")
	kit._tick_hammer(0.2)
	expect(hidden.health==hidden.max_health,"Empty hammer swing cannot originate splash behind a wall")
	await clear()
	fixture("divine_hammer")
	player.sprite.sprite_frames=player.sprite.sprite_frames.duplicate(true)
	var strips:=player.sprite.sprite_frames
	for index in range(strips.get_frame_count("special_down")-1,2,-1):strips.remove_frame("special_down",index)
	strips.set_animation_speed("special_down",14)
	player.facing_name="right";player._play_action_animation("special",0.4,0.4)
	player.sprite.set_frame_and_progress(3,0.4)
	var normalized:float=3.4/strips.get_frame_count("special_right")
	player.retarget_action_facing(Vector2.DOWN)
	var actual_progress:float=(player.sprite.frame+player.sprite.frame_progress)/strips.get_frame_count("special_down")
	var duration:float=strips.get_frame_count("special_down")/(strips.get_animation_speed("special_down")*player.sprite.get_playing_speed())
	expect(absf(actual_progress-normalized)<0.001,"Turning to a different-length strip preserves normalized contact pose")
	expect(absf(duration-0.4)<0.001,"Different strip FPS/frame count cannot change attack duration")
	await clear()
	for despawn in [false,true]:
		fixture("divine_hammer")
		var lost:=foe();lost.position=player.position+Vector2(100,0)
		var survivor:=foe();survivor.position=player.position+Vector2(0,120)
		kit._queue_hammer({"damage":10,"warrior_cast":1},1,lost)
		if despawn:lost.queue_free()
		else:lost.receive_attack({"damage":1000000,"damage_type":"physical"},null)
		await process_frame
		kit._tick_hammer(0.01)
		expect(not kit.hammer_chain.is_empty() and kit.hammer_chain.target.get_ref()==survivor,"Hammer replaces a genuinely dead/freed target during follow-up anticipation")
		kit._tick_hammer(0.2)
		expect(survivor.health==survivor.max_health-10,"Replacement receives exactly one follow-up contact, without duplicate or stale-target hits")
		await clear()
	print("Hammer retarget/terrain: %d checks, %d failures"%[checks,failures.size()])
	quit(0 if failures.is_empty() else 1)
