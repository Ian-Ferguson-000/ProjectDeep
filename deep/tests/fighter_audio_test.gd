extends "res://tests/fighter_production_test.gd"

var heard:Array[String]=[]

func _run()->void:
	var audio:Node=root.get_node("Audio")
	audio.set_context("testing_ground")
	audio.event_played.connect(func(id:String,_point:Vector2)->void:heard.append(id))
	for id in ["grim_reaver","sentinel_shield","archon_crossbow"]:
		fixture(id);foe()
		if id=="grim_reaver":kit.rules.base_critical=1;kit.rules.critical_cap=1
		heard.clear();audio.last_played.clear()
		for voice in audio.voices.duplicate():audio._finish_voice(voice)
		kit.perform("basic",{"started":true})
		expect(not heard.has("fighter_critical") and not heard.has("fighter_metal"),id+": impact cue must not play at activation")
		for step in 120:kit._physics_process(1.0/120)
		expect(heard.has("fighter_critical" if id=="grim_reaver" else "fighter_metal"),id+": actual contact plays distinct impact cue")
		await clear()
	fixture("valkyrian_sling")
	kit._launch_sling({"damage":10,"warrior_cast":1},false)
	kit.missiles[0].returning=true;kit.missiles[0].position=player.position+Vector2(50,0)
	heard.clear();audio.last_played.clear()
	for voice in audio.voices.duplicate():audio._finish_voice(voice)
	kit.perform("defensive",{"started":true})
	expect(heard.has("fighter_metal"),"Successful return parry plays contact response")
	heard.clear();kit.perform("defensive",{"started":true})
	expect(not heard.has("fighter_metal"),"Invalid repeat parry does not play a success cue")
	await clear()
	fixture("sentinel_shield")
	var heavy:=foe();heavy.boss=true
	heard.clear();audio.last_played.clear()
	for voice in audio.voices.duplicate():audio._finish_voice(voice)
	strike(heavy,1,1)
	expect(heard.has("fighter_resisted") and not heard.has("fighter_metal"),"Heavy Shield contact replaces the normal clang with resistant feedback")
	var recoil:Array=kit.effects.filter(func(effect:Dictionary)->bool:return effect.kind=="shield_shove")
	expect(recoil.size()==1 and bool(recoil[0].resisted),"Heavy Shield contact uses resistant recoil rather than a full skid")
	expect(Vector2(recoil[0].endpoint)==heavy.global_position,"Shield recoil anchors at actual collision-resolved position")
	await clear()
	fixture("dragonbone_dagger")
	var armored:=foe()
	heard.clear();audio.last_played.clear()
	for voice in audio.voices.duplicate():audio._finish_voice(voice)
	for serial in range(1,6):strike(armored,serial,1)
	expect(not heard.has("fighter_armor_break"),"Dagger armor-break cue waits for the stack cap")
	strike(armored,6,1)
	expect(heard.count("fighter_armor_break")==1,"Reaching armor cap plays one fracture cue")
	# Clear the mixer cooldown so this proves gameplay deduplication, not merely
	# an audio rate limit masking repeated event requests.
	heard.clear();audio.last_played.clear()
	for voice in audio.voices.duplicate():audio._finish_voice(voice)
	for serial in range(7,12):strike(armored,serial,1)
	expect(not heard.has("fighter_armor_break"),"Refreshing capped wounds cannot replay the fracture cue")
	armored._tick_fighter_statuses(5)
	for serial in range(12,18):strike(armored,serial,1)
	expect(heard.count("fighter_armor_break")==1,"A new stack set can fracture again after expiry")
	await clear()
	print("Fighter audio: %d checks, %d failures"%[checks,failures.size()])
	quit(0 if failures.is_empty() else 1)
