  "r": "mossy rock (decoration)",
  "p": "pebbles (decoration)",
  "m": "mushrooms (decoration)",
  "b": "bush (decoration)",
  "F": "campfire (camp rooms only: shop and rest)",
  "e": "enemy spawn",
